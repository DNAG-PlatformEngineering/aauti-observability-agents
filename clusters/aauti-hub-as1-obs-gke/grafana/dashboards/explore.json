{
  "uid": "explore",
  "title": "Explore",
  "description": "All products in one place (Loki / Mimir, every tenant): pick Product, Env, Cluster, Namespace, App, Pod, Container; each field only lists values under the ones before it.",
  "tags": [
    "observability-stack",
    "explore"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "product",
        "label": "Product",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({product=~\".+\"}, product)",
        "definition": "label_values({product=~\".+\"}, product)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "env",
