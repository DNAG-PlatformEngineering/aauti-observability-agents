{
  "uid": "__TENANT__-cluster-health",
  "title": "__TENANT_TITLE__ / Cluster health",
  "description": "Node, pod and deployment health plus warning events for the tenant's cluster(s).",
  "tags": [
    "observability-stack",
    "__TENANT__",
    "kubernetes",
    "health"
  ],
  "timezone": "browser",
