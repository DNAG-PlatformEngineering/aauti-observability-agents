  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "__ENVIRONMENTS__",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "cluster-var"
        },
        "definition": "label_values(up, cluster)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment|shared\"}, namespace)",
          "refId": "namespace-var"
        },
        "definition": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment|shared\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
