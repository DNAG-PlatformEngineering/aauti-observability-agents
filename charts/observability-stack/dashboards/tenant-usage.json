      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_DS__"
          },
          "expr": "sum by (user) (rate(cortex_distributor_received_samples_total{user=~\"$tenant\"}[5m])) / on (user) max by (user) (cortex_limits_overrides{limit_name=\"ingestion_rate\", user=~\"$tenant\"})",
          "refId": "A",
          "legendFormat": "{{user}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
