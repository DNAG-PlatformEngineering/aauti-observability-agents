          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOGS_DS__"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOGS_DS__"
          },
          "expr": "{cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\", app=~\"$app\"} |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
