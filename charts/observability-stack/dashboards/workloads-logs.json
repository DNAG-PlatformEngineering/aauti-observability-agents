    {
      "type": "timeseries",
      "title": "HTTP requests / s (nginx exporter)",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_DS__"
      },
      "description": "Any pod annotated prometheus.io/scrape is collected; add panels for your own app metrics here.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_DS__"
          },
          "expr": "sum by (namespace, app) (rate(nginx_http_requests_total{cluster=~\"$cluster\", environment=~\"$environment|shared\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{app}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
