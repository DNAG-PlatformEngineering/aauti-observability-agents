        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOGS_DS__"
      },
      "description": "log_type drives per-type retention on the hub.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOGS_DS__"
          },
          "expr": "sum by (log_type) (bytes_over_time({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\", app=~\"$app\"} [$__auto]))",
          "refId": "A",
          "legendFormat": "{{log_type}}"
        }
