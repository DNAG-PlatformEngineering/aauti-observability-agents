      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOGS_DS__"
          },
          "expr": "sum by (detected_level) (count_over_time({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\", app=~\"$app\"} [$__auto]))",
