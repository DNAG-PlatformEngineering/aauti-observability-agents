{
  "uid": "__TENANT__-workloads-logs",
  "title": "__TENANT_TITLE__ / Workloads & logs",
  "description": "Application-level view: log volume, errors, log search and workload metrics.",
  "tags": [
    "observability-stack",
    "__TENANT__",
    "application",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "__ENVIRONMENTS__",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "cluster-var"
        },
        "definition": "label_values(up, cluster)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment\"}, namespace)",
          "refId": "namespace-var"
        },
        "definition": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "__LOGS_DS__"
        },
        "query": "label_values({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\"}, app)",
        "definition": "label_values({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\"}, app)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Log search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "__TENANT__"
      ],
      "asDropdown": true,
      "title": "__TENANT_TITLE__"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Logs",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines by app",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOGS_DS__"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOGS_DS__"
          },
          "expr": "sum by (app) (count_over_time({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\", app=~\"$app\"} [$__auto]))",
          "refId": "A",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errors by app (detected_level)",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOGS_DS__"
      },
      "description": "Loki auto-detects the level of each line (structured metadata detected_level).",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOGS_DS__"
          },
          "expr": "sum by (app) (count_over_time({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"$namespace\", app=~\"$app\"} | detected_level=~\"error|fatal|critical\" [$__auto]))",
          "refId": "A",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
