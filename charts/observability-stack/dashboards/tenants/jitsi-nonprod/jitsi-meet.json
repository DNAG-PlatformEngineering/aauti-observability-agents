        "query": "label_values({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"jitsi.*\"}, pod)",
        "definition": "label_values({cluster=~\"$cluster\", environment=~\"$environment\", namespace=~\"jitsi.*\"}, pod)",
