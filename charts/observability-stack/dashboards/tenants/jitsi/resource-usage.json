{
  "uid": "__TENANT__-resource-usage",
  "title": "__TENANT_TITLE__ / Resource usage",
  "description": "CPU, memory, network and storage consumption by namespace, pod and node.",
  "tags": [
    "observability-stack",
    "__TENANT__",
    "kubernetes",
    "resources"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "__ENVIRONMENTS__",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(up, cluster)",
          "refId": "cluster-var"
        },
        "definition": "label_values(up, cluster)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_DS__"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment|shared\"}, namespace)",
          "refId": "namespace-var"
        },
        "definition": "label_values(kube_pod_info{cluster=~\"$cluster\", environment=~\"$environment|shared\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "__TENANT__"
      ],
      "asDropdown": true,
      "title": "__TENANT_TITLE__"
    }
